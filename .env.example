# ---- Database (TiDB Serverless) ----
# Connection string dari user. CATATAN: string asli menunjuk database sistem "sys";
# diganti ke "scan_manifest". Jalankan dulu: CREATE DATABASE scan_manifest;
DATABASE_URL="mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/scan_manifest?sslaccept=strict"

# ---- Session ----
SESSION_SECRET="ganti-dengan-hasil-openssl-rand-hex-32"
SESSION_HOURS="12"

# ---- OCS (service account untuk kirim manifest) ----
OCS_BASE_URL="https://ocs.iegsystem.id"
OCS_USERNAME="ADMIN"
OCS_PASSWORD="isi-password-ocs"
OCS_COMPANYDB="EJI_WMS"
OCS_DEFAULT_AREA="Pusat"
# true = scan ke-2 langsung dikirim ke OCS; false = hanya disimpan lokal (mode uji coba)
OCS_ENABLED="true"
OCS_TIMEOUT_MS="30000"
# Bentuk kode basket yang dikirim ke OCS sebagai basketId:
#   lengkap = JNT-20260917-001 (16 karakter)  |  pendek = JNT1709001 (10 karakter, tanpa "-")
BASKET_CODE_STYLE="lengkap"

# ---- Cron (Vercel) ----
CRON_SECRET="ganti-dengan-string-acak"
