{
  "name": "scan-manifest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs",
    "db:collation": "node --env-file=.env tools/fix-collation.mjs",
    "ocs:test": "node --env-file=.env tools/ocs-test.mjs",
    "user:password": "node --env-file=.env tools/set-password.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.16.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
