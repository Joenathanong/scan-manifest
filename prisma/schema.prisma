// Scan Manifest IEG — TiDB Serverless
// CATATAN TiDB: relationMode="prisma" -> setiap kolom relasi WAJIB punya @@index.
// PK selalu Int autoincrement: mengubah PK di TiDB (clustered index) hampir mustahil.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  ADMIN
  SUPERVISOR
  OPERATOR
}

enum BasketStatus {
  OPEN
  CLOSED
  MANIFESTING
  DONE
}

enum ItemStatus {
  AWAITING_PICKUP
  PICKUP
  VOID
}

enum OcsState {
  NONE
  PENDING
  SENT
  FAILED
  INVALID
}

enum DocStatus {
  OPEN
  SYNCING
  SUBMITTED
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique @db.VarChar(64)
  name               String   @db.VarChar(120)
  passwordHash       String   @db.VarChar(255)
  role               Role     @default(OPERATOR)
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  // --- Akun OCS milik operator ini (opsional) ---
  // Kalau diisi, manifest dikirim ke OCS memakai akun ini sehingga dokumen
  // tercatat atas namanya (mis. MANIFEST001), bukan akun sistem di .env.
  ocsUserCode        String?  @db.VarChar(64)
  ocsUsername        String?  @db.VarChar(64)
  // Terenkripsi AES-256-GCM dengan kunci turunan SESSION_SECRET.
  // TIDAK PERNAH dikirim ke browser dalam bentuk apa pun.
  ocsPasswordEnc     String?  @db.VarChar(512)
  ocsCompanyDb       String?  @db.VarChar(64)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  baskets      Basket[]      @relation("BasketCreatedBy")
  sessions     ScanSession[] @relation("SessionUser")
  scan1Items   ScanItem[]    @relation("Scan1By")
  scan2Items   ScanItem[]    @relation("Scan2By")
  voidedItems  ScanItem[]    @relation("VoidedBy")
  docs         ManifestDoc[] @relation("DocCreatedBy")
  manifestScans ManifestScan[] @relation("ManifestScanBy")
  audits       AuditLog[]

  @@index([active])
  @@index([role])
}

model Expedisi {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(32)
  name       String   @db.VarChar(80)
  ocsShipper String   @db.VarChar(40)
  // Awalan kode basket yang dikirim ke OCS. Kolom basketId di OCS hanya
  // varchar(10), jadi awalan ini WAJIB pendek (maks 3 huruf) dan unik.
  // Kosong = diambil 3 huruf pertama dari `code`.
  ocsPrefix  String?  @db.VarChar(3)
  prefixes   String   @default("") @db.VarChar(1000)
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  baskets Basket[]
  items   ScanItem[]

  @@index([active])
}

model Basket {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(48)
  expedisiId  Int
  areaId      String       @default("Pusat") @db.VarChar(40)
  date        DateTime     @db.Date
  seq         Int
  status      BasketStatus @default(OPEN)
  note        String?      @db.VarChar(255)
  createdById Int
  closedAt    DateTime?
  printedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  expedisi  Expedisi      @relation(fields: [expedisiId], references: [id])
  createdBy User          @relation("BasketCreatedBy", fields: [createdById], references: [id])
  items     ScanItem[]
  docs      ManifestDoc[]

  @@unique([expedisiId, date, seq])
  @@index([expedisiId])
  @@index([createdById])
  @@index([date])
  @@index([status])
  @@index([date, status])
}

model ScanItem {
  id         Int        @id @default(autoincrement())
  resi       String     @db.VarChar(64)
  // Unik hanya selama aktif. Saat di-void diisi null supaya resi bisa discan ulang.
  resiUnik   String?    @unique @db.VarChar(64)
  // basketId diisi saat SCAN 2 (keranjang final dibentuk setelah sortir per ekspedisi)
  basketId   Int?
  // ekspedisi hasil tebakan prefix saat scan 1; dikoreksi ke ekspedisi basket saat scan 2
  expedisiId Int?
  sessionId  Int?
  scanDate   DateTime   @db.Date
  status     ItemStatus @default(AWAITING_PICKUP)

  scan1At   DateTime  @default(now())
  scan1ById Int
  scan2At   DateTime?
  scan2ById Int?

  manifestDocId Int?
  ocsState      OcsState @default(NONE)
  ocsOrderId    String?  @db.VarChar(64)
  ocsTracking   String?  @db.VarChar(64)
  ocsReason     String?  @db.VarChar(191)
  ocsSentAt     DateTime?

  // Batch serah terima Scan 1. Terisi saat operator menekan Submit per
  // ekspedisi — resi yang sudah disubmit tidak ikut dihitung lagi di panel
  // total, tapi datanya tetap utuh.
  submitId   Int?

  voidedAt   DateTime?
  voidedById Int?
  voidReason String?   @db.VarChar(191)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  basket   Basket?      @relation(fields: [basketId], references: [id])
  expedisi Expedisi?    @relation(fields: [expedisiId], references: [id])
  session  ScanSession? @relation(fields: [sessionId], references: [id])
  scan1By  User         @relation("Scan1By", fields: [scan1ById], references: [id])
  scan2By  User?        @relation("Scan2By", fields: [scan2ById], references: [id])
  voidedBy User?        @relation("VoidedBy", fields: [voidedById], references: [id])
  doc      ManifestDoc? @relation(fields: [manifestDocId], references: [id])

  @@index([basketId])
  @@index([expedisiId])
  @@index([sessionId])
  @@index([scan1ById])
  @@index([scan2ById])
  @@index([voidedById])
  @@index([manifestDocId])
  @@index([resi])
  @@index([status])
  @@index([scanDate])
  @@index([scanDate, status])
  @@index([ocsState])
  // Dipakai Scan 2 untuk mengenali paket lewat order ID / resi OCS, bukan
  // hanya lewat nomor yang discan di tahap 1.
  @@index([ocsOrderId])
  @@index([ocsTracking])
  @@index([submitId])
  // Panel total per ekspedisi: hitung per sesi yang belum disubmit.
  @@index([sessionId, submitId])
}

// Sesi scan pertama: dibuat otomatis per operator per hari.
// Hanya untuk pengelompokan & laporan — TIDAK dicetak dan tidak punya barcode.
model ScanSession {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(48)
  date      DateTime  @db.Date
  seq       Int
  userId    Int
  // Dipakai mode desktop (Serah Terima Dispatch): operator boleh berbeda
  // dari akun yang login, dan shiftnya dicatat per batch.
  operatorName String? @db.VarChar(120)
  shift        String? @db.VarChar(32)
  // Berapa kali resi dobel ditolak selama sesi ini — untuk KPI "Duplikat terdeteksi".
  dupCount     Int     @default(0)
  note      String?   @db.VarChar(255)
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User       @relation("SessionUser", fields: [userId], references: [id])
  items ScanItem[]

  @@unique([date, seq])
  @@index([userId])
  @@index([date])
}

model ManifestDoc {
  id          Int       @id @default(autoincrement())
  basketId    Int
  basketCode  String    @db.VarChar(48)
  shipper     String    @db.VarChar(40)
  areaId      String    @db.VarChar(40)
  ocsDocId    Int?
  ocsDocNo    String?   @db.VarChar(64)
  status      DocStatus @default(OPEN)
  totalValid    Int     @default(0)
  totalNotValid Int     @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  lastSyncAt  DateTime?
  lastError   String?   @db.Text
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  basket    Basket         @relation(fields: [basketId], references: [id])
  createdBy User           @relation("DocCreatedBy", fields: [createdById], references: [id])
  items     ScanItem[]
  scans     ManifestScan[]

  @@index([basketId])
  @@index([createdById])
  @@index([status])
  @@index([startedAt])
  @@index([ocsDocId])
}

// Satu baris per scan di proses kedua — termasuk scan yang DITOLAK OCS,
// yang tidak punya ScanItem (mis. resi tidak terdaftar di basket).
model ManifestScan {
  id               Int      @id @default(autoincrement())
  docId            Int
  scanResult       String   @db.VarChar(64)
  manifestTime     DateTime
  orderId          String?  @db.VarChar(64)
  trackingNumber   String?  @db.VarChar(64)
  shippingProvider String   @db.VarChar(40)
  valid            Boolean  @default(true)
  reason           String?  @db.VarChar(191)
  // Berapa kali barcode ini ditembak ulang. Scan dobel TIDAK menambah baris
  // baru — barisnya satu, penghitungnya yang naik, supaya daftar scan tidak
  // dibanjiri baris merah untuk paket yang sama.
  dupCount         Int      @default(1)
  itemId           Int?
  scannedById      Int
  syncedAt         DateTime?
  createdAt        DateTime @default(now())

  doc       ManifestDoc @relation(fields: [docId], references: [id])
  scannedBy User        @relation("ManifestScanBy", fields: [scannedById], references: [id])

  @@index([docId])
  @@index([scannedById])
  @@index([itemId])
  @@index([valid])
  @@index([syncedAt])
  // Pemeriksaan dobel lintas identitas (resi vs order ID).
  @@index([orderId])
  @@index([trackingNumber])
}

// Salinan daftar "order belum dimanifest" dari OCS saat dokumen dibuka.
// Dipakai supaya validasi tiap scan cukup 1 query berindeks, tidak perlu
// memanggil OCS per resi (persis pola aplikasi OCS sendiri).
model ManifestCandidate {
  id             Int      @id @default(autoincrement())
  docId          Int
  orderId        String   @db.VarChar(64)
  trackingNumber String   @db.VarChar(64)
  used           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([docId, trackingNumber])
  @@index([docId, orderId])
  @@index([docId, used])
}

model OcsOutbox {
  id            Int          @id @default(autoincrement())
  kind          String       @db.VarChar(40)
  docId         Int?
  payload       Json?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @db.Text
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  doneAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([docId])
}

model Counter {
  key       String   @id @db.VarChar(64)
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id       Int      @id @default(autoincrement())
  userId   Int?
  action   String   @db.VarChar(64)
  entity   String   @db.VarChar(40)
  entityId String   @db.VarChar(64)
  detail   Json?
  at       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([at])
}

/**
 * Batch serah terima Scan 1 — satu baris per ekspedisi per submit.
 *
 * Submit di Scan 1 TIDAK menyentuh OCS dan tidak membentuk basket. Ia hanya
 * mengunci hitungan: "sekian resi ekspedisi X sudah diserahterimakan pada jam
 * sekian oleh siapa". Basket final tetap dibentuk di Scan 2.
 */
model ScanSubmit {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(48)
  sessionId    Int
  // null = kelompok resi yang ekspedisinya belum dikenali
  expedisiId   Int?
  // Disalin supaya laporan lama tetap terbaca walau master ekspedisi berubah.
  expedisiCode String   @db.VarChar(32)
  jumlah       Int
  date         DateTime @db.Date
  seq          Int
  note         String?  @db.VarChar(255)
  submittedById Int
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([expedisiId])
  @@index([submittedById])
  @@index([date])
}

/**
 * Pemetaan order ID <-> nomor resi <-> kurir, hasil salinan dari daftar order
 * belum-manifest milik OCS.
 *
 * Gunanya: di Scan 1 operator kadang menembak barcode ORDER ID, bukan nomor
 * resi. Tanpa pemetaan ini ekspedisinya tidak bisa ditebak dari pola nomor,
 * dan resi itu masuk sebagai "BELUM DIKENALI" sampai Scan 2.
 *
 * Diisi otomatis setiap Scan 2 membuka dokumen manifest (daftar Items dari OCS
 * disalin ke sini sekalian), jadi tidak ada panggilan OCS tambahan.
 */
model OrderLookup {
  id             Int      @id @default(autoincrement())
  orderId        String   @unique @db.VarChar(64)
  trackingNumber String   @db.VarChar(64)
  // Nilai apa adanya dari OCS, mis. "J&T", "SiCepat".
  shipper        String   @db.VarChar(40)
  expedisiId     Int?
  syncedAt       DateTime @default(now())

  @@index([trackingNumber])
  @@index([shipper])
  @@index([expedisiId])
  @@index([syncedAt])
}
